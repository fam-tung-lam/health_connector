{
  "name": "health-connector-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "site:prepare": "node scripts/prepare-site-assets.mjs",
    "site:check": "node scripts/check-doc-symbols.mjs && node scripts/check-doc-links.mjs",
    "site:build": "npm run site:prepare && npm run site:check && vitepress build webapp",
    "site:dev": "npm run site:prepare && vitepress dev webapp",
    "site:preview": "vitepress preview webapp"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
